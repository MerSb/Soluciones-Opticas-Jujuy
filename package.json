{
  "name": "soluciones-opticas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:staging": "tsx prisma/seed-staging.ts",
    "db:reset:local": "node --env-file=.env scripts/assert-local-db.mjs && prisma migrate reset",
    "dev:api": "npm run dev -w apps/api",
    "test:api": "npm run test -w apps/api",
    "typecheck:api": "npm run typecheck -w apps/api",
    "build:api": "npm run build -w apps/api",
    "start:api": "npm run start -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test:web": "npm run test -w apps/web",
    "typecheck:web": "npm run typecheck -w apps/web",
    "build:web": "npm run build -w apps/web"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}

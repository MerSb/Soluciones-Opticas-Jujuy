# Copy to .env for local work. Never commit the real .env file.
#
# Environment strategy — see docs/ENVIRONMENT.md:
#   local:      docker compose up -d  (this repo's docker-compose.yml)
#   staging:    Railway PostgreSQL — connection string lives only in
#               Railway's own environment config, never here, never in Git
#   production: not provisioned yet — see docs/ENVIRONMENT.md

# Matches docker-compose.yml. Dev-only credentials, not sensitive.
DATABASE_URL="postgresql://soluciones_opticas:soluciones_opticas@localhost:5437/soluciones_opticas_dev?schema=public"

# apps/api — see docs/API.md
PORT=3001
# development | test | production — never "staging". Staging deploys
# still set NODE_ENV=production (see APP_ENV below and
# docs/ENVIRONMENT.md for why).
NODE_ENV=development
# development | staging | production — the actual environment label.
# Separate from NODE_ENV rather than widening it, so staging can set
# NODE_ENV=production (getting production-mode behavior from
# Node/Express/npm tooling) while still being distinguishable from real
# production in logs.
APP_ENV=development
# Comma-separated allowlist. Never "*" — see docs/API.md "CORS".
# 5173 is Vite's default dev port, for when apps/web exists.
CORS_ORIGINS=http://localhost:5173
# Required in every environment — generate a real local value with
# `openssl rand -hex 32`. Never commit a real one. See
# docs/adr/0018-authentication-session-strategy.md.
JWT_SECRET=

# Product image storage — apps/api only, never exposed to the frontend.
# All three optional and all-or-nothing (see apps/api/src/lib/env.ts):
# leave every one unset to run the app locally without image upload;
# the rest of the app works fine, only the upload-signature endpoint
# refuses with a clear error. From your Cloudinary account's Dashboard
# → "API Keys". Never commit real values. See
# docs/adr/0022-cloudinary-image-pipeline.md and docs/IMAGE_PIPELINE.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public storefront domain — base of every URL in /sitemap.xml
# (apps/api/src/services/sitemap.service.ts). Defaults to the live domain.
# PUBLIC_SITE_URL=https://www.solucionesopticas.com.ar

# Safety switches checked at startup (apps/api/src/lib/runtime-safety.ts) —
# the API refuses to start on an unsafe combination.
# - SANDBOX_MODE=on only in the isolated test environment: needs a database
#   prepared by `npm run sandbox:init` (marked as sandbox), no CLOUDINARY_*,
#   and no URL of the real store.
# - PAYMENTS_MODE: off (default; the token is ignored) | test (Mercado Pago
#   TEST account — sandbox or local development only) | live (real account;
#   never in the sandbox). The account is checked with Mercado Pago itself at
#   startup: test and production tokens both start with APP_USR.
SANDBOX_MODE=off
PAYMENTS_MODE=off

# Mercado Pago — Checkout Pro via the Orders API (POST /v1/orders). apps/api
# only, optional (docs/PAYMENTS.md, ADR-0026/0027). Leave all three commented
# out (or PAYMENTS_MODE=off) to run without payments: everything works and
# "Pagar con Mercado Pago" answers 503 PAYMENT_PROVIDER_NOT_CONFIGURED.
#
# - MERCADOPAGO_ACCESS_TOKEN: the TEST access token of the app (Mercado Pago
#   Developers → your app → Credenciales de prueba). Never a production token
#   outside production. In a deployed environment it goes ONLY in the API
#   service's own variables (sealed), never in apps/web, never committed,
#   never pasted in a terminal or a chat. The app never logs it.
# - PUBLIC_WEB_URL: public origin of THIS environment's web app, used for the
#   Checkout Pro return URLs and the invoice link (e.g. http://localhost:5173
#   locally, the branch Preview URL in an isolated test environment). Not the
#   same as PUBLIC_SITE_URL above (the storefront domain for the sitemap).
# - MERCADOPAGO_WEBHOOK_SECRET: the "Firma secreta" shown after saving the
#   webhook (your app → Configuración de Webhooks → mode "Prueba" → event
#   "Order (Mercado Pago)" → URL https://<api>/api/payments/mercadopago/webhook).
#   Without it the webhook answers 503 and processes nothing.
#
# Uncomment only with a real value: a present but empty value fails validation.
# MERCADOPAGO_ACCESS_TOKEN=
# PUBLIC_WEB_URL=
# MERCADOPAGO_WEBHOOK_SECRET=

# Lenses are not charged online until the shop decides so: off | on.
# Must match the web's VITE_ONLINE_LENS_SALES.
ONLINE_LENS_SALES=off

# Electronic invoicing (ADR-0036, docs/FACTURACION_ARCA.md). off | mock | homologacion
# (production is not accepted). Certificate and private key are FILE PATHS outside
# the repository; never paste their contents here.
ARCA_MODE=off
# ARCA_CERT_PATH=/ruta/privada/fuera-del-repo/certificado-homologacion.pem
# ARCA_KEY_PATH=/ruta/privada/fuera-del-repo/clave-privada.key
# ARCA_TIMEOUT_MS=30000
# Sending invoices to buyers: off | mock (no real email provider yet).
INVOICE_EMAIL_MODE=off

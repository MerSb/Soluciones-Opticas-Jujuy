# Copy to .env for local work. Never commit the real .env file.
#
# Environment strategy — see docs/ENVIRONMENT.md:
#   local:      docker compose up -d  (this repo's docker-compose.yml)
#   staging:    Railway PostgreSQL — connection string lives only in
#               Railway's own environment config, never here, never in Git
#   production: not provisioned yet — see docs/ENVIRONMENT.md

# Matches docker-compose.yml. Dev-only credentials, not sensitive.
DATABASE_URL="postgresql://soluciones_opticas:soluciones_opticas@localhost:5437/soluciones_opticas_dev?schema=public"

# apps/api — see docs/API.md
PORT=3001
# development | test | production — never "staging". Staging deploys
# still set NODE_ENV=production (see APP_ENV below and
# docs/ENVIRONMENT.md for why).
NODE_ENV=development
# development | staging | production — the actual environment label.
# Separate from NODE_ENV rather than widening it, so staging can set
# NODE_ENV=production (getting production-mode behavior from
# Node/Express/npm tooling) while still being distinguishable from real
# production in logs.
APP_ENV=development
# Comma-separated allowlist. Never "*" — see docs/API.md "CORS".
# 5173 is Vite's default dev port, for when apps/web exists.
CORS_ORIGINS=http://localhost:5173
# Required in every environment — generate a real local value with
# `openssl rand -hex 32`. Never commit a real one. See
# docs/adr/0018-authentication-session-strategy.md.
JWT_SECRET=

# Product image storage — apps/api only, never exposed to the frontend.
# All three optional and all-or-nothing (see apps/api/src/lib/env.ts):
# leave every one unset to run the app locally without image upload;
# the rest of the app works fine, only the upload-signature endpoint
# refuses with a clear error. From your Cloudinary account's Dashboard
# → "API Keys". Never commit real values. See
# docs/adr/0022-cloudinary-image-pipeline.md and docs/IMAGE_PIPELINE.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Future — not implemented yet, added when each integration is built ---
# MERCADOPAGO_ACCESS_TOKEN=
# ARCA_CERT_PATH=

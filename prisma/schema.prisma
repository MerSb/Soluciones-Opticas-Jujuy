// Etapa 1 — institutional site + real, database-backed catalog.
// Etapa 2 (this addition) — customer authentication + favorites, per
// ADR-0005 (single users table + role enum), ADR-0006 (self-rolled JWT,
// access + rotating refresh), ADR-0011 (nullable auth_provider columns).
//
// Future entities (user_measurements, recommendation_rules, orders,
// payments, fiscal_invoices, audit_logs) intentionally do not exist yet.
// See docs/ARCHITECTURE.md and docs/adr/ for why, and for the
// conventions applied below (slug immutability, current_frame_* naming,
// Cloudinary public_id storage, product_variants from day one).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug         String    @unique
  logoPublicId String?   @map("logo_public_id")
  description  String?
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug      String    @unique
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug       String @unique
  brandId    String @map("brand_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  /// Descriptive/filter attribute (e.g. round, square, cat-eye). Nullable —
  /// populated progressively as catalog content is entered.
  shape     String?
  basePrice Decimal @map("base_price") @db.Decimal(10, 2)

  // Frame measurements — properties of the physical design, shared across
  // every color variant. Never confused with the future current_frame_*
  // fields on user_measurements (Etapa 2, ADR-0012): those describe a
  // customer's own frame, these describe the catalog item. Nullable
  // because the proposal states these are provided "cuando esté disponible".
  lensWidth    Float? @map("lens_width")
  bridgeWidth  Float? @map("bridge_width")
  templeLength Float? @map("temple_length")
  lensHeight   Float? @map("lens_height")
  frameWidth   Float? @map("frame_width")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  favorites Favorite[]

  @@index([brandId])
  @@index([categoryId])
  // A GIN trigram index on `name` (pg_trgm), backing GET /products?q=,
  // is created via raw SQL in the initial migration — see ADR-0014 for
  // why this is not declared here through Prisma's postgresqlExtensions
  // preview feature. docs/DATABASE_DESIGN.md documents the operational
  // consequence: this index is intentionally unmanaged by schema.prisma.
  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Nullable — a product may exist as a single, undifferentiated variant
  /// before (or unless) the client's inventory is tracked per color. See
  /// docs/DATABASE_DESIGN.md "Open question: per-color stock".
  color    String?
  material String?
  sku      String  @unique

  /// CHECK (stock >= 0) is added as raw SQL in the first migration —
  /// Prisma schema has no declarative CHECK constraint syntax. Plain
  /// column here; the constraint is a data-integrity guard, not
  /// inventory-management business logic.
  stock         Int      @default(0)
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  /// Cloudinary public_id — never the full delivery URL. See ADR-0010;
  /// the API/integration layer builds the delivery URL at request time.
  cloudinaryPublicId String @map("cloudinary_public_id")
  /// Required, not defaulted to empty — accessibility requirement.
  /// The admin/seed layer is responsible for supplying real alt text
  /// (falling back to the product name is an application concern, not
  /// a schema-level default).
  alt                String

  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("product_images")
}

model Branch {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  address String
  phone   String?

  whatsapp      String?
  /// Free-form per-day opening hours; not normalized into its own table —
  /// no query currently needs to filter/sort by hours.
  hours         Json?
  lat           Float?
  lng           Float?
  googleMapsUrl String? @map("google_maps_url")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("branches")
}

/// CUSTOMER | ADMIN today — the minimum useful model for this phase.
/// ADR-0005 approves a richer eventual set (customer | staff | admin |
/// super_admin); adding more values later is an additive enum change,
/// not a rewrite, so it isn't pre-built here (per this phase's own
/// "start minimal" direction).
enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  /// Nullable per ADR-0011: OAuth-only users (not implemented yet) will
  /// never have one. A local-auth user always has one — enforced in
  /// application code (the register flow), not the schema, since the
  /// schema must stay valid for the future OAuth case too.
  passwordHash String? @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  role Role @default(CUSTOMER)

  /// Both nullable per ADR-0011 — present from this migration so a
  /// future OAuth strategy is an additive change, not a users-table
  /// migration. Unused by any code path in this phase.
  authProvider   String? @map("auth_provider")
  authProviderId String? @map("auth_provider_id")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  favorites      Favorite[]
  refreshTokens  RefreshToken[]
  opticalProfile CustomerOpticalProfile?

  @@map("users")
}

/// Opaque, rotating refresh credential per ADR-0006 — never a JWT itself
/// (nothing to decode; a database lookup is the whole point, so reuse
/// after rotation or logout can actually be detected/revoked). Only a
/// SHA-256 hash of the raw token is stored, same reasoning as password
/// hashing: a database read alone must never be enough to impersonate a
/// session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// A customer can favorite a given product only once — enforced by the
  /// database, not just application logic (§21 of the auth/favorites
  /// brief).
  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

/// Canonical machine values for frame shape — chosen to already match
/// this catalog's own free-text `Product.shape` values where seeded data
/// overlaps (aviator, rectangular, round, wrap all appear verbatim in
/// prisma/seed.ts today) plus the remaining shapes named in the optical-
/// profile brief. `Product.shape`/`ProductVariant.material`/`.color`
/// remain plain free text — see docs/adr/0019 for why a catalog-schema
/// change was deliberately avoided and how the future recommender is
/// expected to reconcile the two sides instead.
enum FrameShape {
  AVIATOR
  RECTANGULAR
  ROUND
  SQUARE
  CAT_EYE
  OVAL
  WRAP
}

/// Mirrors the material strings actually seeded (METAL/ACETATE/TR90 ~
/// "Metal"/"Acetato"/"TR90") plus common additional eyewear materials.
enum FrameMaterial {
  METAL
  ACETATE
  TR90
  MIXED
  INJECTED
  NYLON
}

/// A small set of color *families*, not an attempt to enumerate every
/// real color name — `ProductVariant.color` is free text ("Carey",
/// "Habano", ...) and always will be for physical-product reasons (real
/// frame colors don't fit a short enum). This exists so a customer can
/// express "I like black frames" as a stable, queryable value; matching
/// it against catalog rows is a future normalization step, not exact
/// string equality.
enum ColorFamily {
  NEGRO
  CAREY
  DORADO
  PLATEADO
  AZUL
  ROJO
  VERDE
  TRANSPARENTE
  ROSA
  HABANO
  MULTICOLOR
}

/// Deliberately small and explainable (§14 of the optical-profile
/// brief) — not a fine-grained taxonomy.
enum StylePreference {
  CLASSIC
  MODERN
  MINIMALIST
  ELEGANT
  URBAN
  BOLD
}

/// One-to-zero-or-one with User (`userId @unique`) — a dedicated entity
/// rather than columns piled onto User, so this stays a clean,
/// independently-evolvable "input data for a future recommender" concept
/// (§16) instead of User accumulating every future preference field
/// directly. See docs/adr/0019-optical-profile-taxonomy.md.
///
/// NOT a prescription: no sphere/cylinder/axis/addition/prism/visual-
/// acuity/diagnosis field exists here or is planned for this entity —
/// see ADR-0008 (no facial-data persistence) and the optical-profile
/// brief's own explicit boundary. `current_frame_*` naming (not
/// `preferred_*`) for the measured facts, per ADR-0012 — this model
/// also adds `currentFrameLensHeight`, which ADR-0012 already named
/// alongside the other three even though it predates this phase's own
/// (3-field) brief; included here to stay consistent with that earlier,
/// already-approved naming decision rather than silently dropping it.
model CustomerOpticalProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// All four nullable independently — a customer may know only part of
  /// their frame's own printed markings (§8). Millimeters; see the ADR
  /// for the validation ranges and why they're plausibility bounds, not
  /// medical/manufacturing tolerances.
  currentFrameLensWidth    Float? @map("current_frame_lens_width")
  currentFrameBridgeWidth  Float? @map("current_frame_bridge_width")
  currentFrameTempleLength Float? @map("current_frame_temple_length")
  currentFrameLensHeight   Float? @map("current_frame_lens_height")

  preferredShapes    FrameShape[]      @map("preferred_shapes")
  preferredMaterials FrameMaterial[]   @map("preferred_materials")
  preferredColors    ColorFamily[]     @map("preferred_colors")
  preferredStyles    StylePreference[] @map("preferred_styles")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_optical_profiles")
}

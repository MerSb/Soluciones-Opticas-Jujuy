// Etapa 1 — institutional site + real, database-backed catalog.
// Etapa 2 (this addition) — customer authentication + favorites, per
// ADR-0005 (single users table + role enum), ADR-0006 (self-rolled JWT,
// access + rotating refresh), ADR-0011 (nullable auth_provider columns).
//
// Future entities (user_measurements, recommendation_rules, orders,
// payments, fiscal_invoices, audit_logs) intentionally do not exist yet.
// See docs/ARCHITECTURE.md and docs/adr/ for why, and for the
// conventions applied below (slug immutability, current_frame_* naming,
// Cloudinary public_id storage, product_variants from day one).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug         String    @unique
  logoPublicId String?   @map("logo_public_id")
  description  String?
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug      String    @unique
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug       String @unique
  brandId    String @map("brand_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  /// Descriptive/filter attribute (e.g. round, square, cat-eye). Nullable —
  /// populated progressively as catalog content is entered.
  shape     String?
  basePrice Decimal @map("base_price") @db.Decimal(10, 2)

  // Frame measurements — properties of the physical design, shared across
  // every color variant. Never confused with the future current_frame_*
  // fields on user_measurements (Etapa 2, ADR-0012): those describe a
  // customer's own frame, these describe the catalog item. Nullable
  // because the proposal states these are provided "cuando esté disponible".
  lensWidth    Float? @map("lens_width")
  bridgeWidth  Float? @map("bridge_width")
  templeLength Float? @map("temple_length")
  lensHeight   Float? @map("lens_height")
  frameWidth   Float? @map("frame_width")

  /// Added by the Admin + Product Catalog Management phase, closing the
  /// gap the recommendation engine (ADR-0020) documented from day one:
  /// `CustomerOpticalProfile.preferredStyles` existed but had nothing on
  /// the product side to compare against, so it never contributed a
  /// point to any score. Reuses `StylePreference` verbatim — the same
  /// enum the customer side already uses — so, unlike shape/material/
  /// color, no free-text normalization layer is needed: this is a real
  /// enum-to-enum comparison from the start. Multi-valued (not single),
  /// matching `preferredStyles`' own cardinality: a product can
  /// reasonably read as both "classic" and "elegant" at once. See
  /// docs/adr/0021-admin-catalog-management.md for the full decision.
  styles StylePreference[] @default([]) @map("styles")

  /// ADR-0028. FRAME = eyewear (every product before accessories existed);
  /// ACCESSORY = case, cord, cleaner... Frame-only features (lens
  /// compatibility, recommendations, optical filters, measurements) only
  /// ever consider FRAME. Immutable after creation.
  kind             ProductKind    @default(FRAME)
  /// Required for ACCESSORY, null for FRAME — CHECK in the migration.
  accessoryRole    AccessoryRole? @map("accessory_role")
  /// Accessories only: listed in /accesorios and purchasable on their own.
  /// Always true for frames (CHECK in the migration).
  soldIndividually Boolean        @default(true) @map("sold_individually")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  brand      Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  favorites  Favorite[]
  orderItems OrderItem[]
  /// Lens types this frame may be configured with (ADR-0023). Empty for
  /// every product that predates the lens catalog — those keep behaving
  /// exactly as before.
  lensTypes  ProductLensType[]

  @@index([brandId])
  @@index([categoryId])
  @@index([kind])
  // A GIN trigram index on `name` (pg_trgm), backing GET /products?q=,
  // is created via raw SQL in the initial migration — see ADR-0014 for
  // why this is not declared here through Prisma's postgresqlExtensions
  // preview feature. docs/DATABASE_DESIGN.md documents the operational
  // consequence: this index is intentionally unmanaged by schema.prisma.
  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Nullable — a product may exist as a single, undifferentiated variant
  /// before (or unless) the client's inventory is tracked per color. See
  /// docs/DATABASE_DESIGN.md "Open question: per-color stock".
  color    String?
  material String?
  sku      String  @unique
  /// Presentation of an accessory variant without a color (e.g. a cleaner's
  /// size). Free text entered by the admin; null for frames. ADR-0028.
  label    String?

  /// CHECK (stock >= 0) is added as raw SQL in the first migration —
  /// Prisma schema has no declarative CHECK constraint syntax. Plain
  /// column here; the constraint is a data-integrity guard, not
  /// inventory-management business logic.
  stock         Int      @default(0)
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  /// Hard delete (ADR-0021): sold lines keep their snapshot and lose
  /// only the link, never the history.
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  /// Cloudinary public_id — never the full delivery URL. See ADR-0010;
  /// the API/integration layer builds the delivery URL at request time.
  cloudinaryPublicId String @map("cloudinary_public_id")
  /// Required, not defaulted to empty — accessibility requirement.
  /// The admin/seed layer is responsible for supplying real alt text
  /// (falling back to the product name is an application concern, not
  /// a schema-level default).
  alt                String

  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("product_images")
}

// Lens catalog — Cristales & Configurador V1, see
// docs/adr/0023-lens-catalog-domain.md and docs/LENS_CONFIGURATOR.md.
// Deliberately separate from ProductVariant: a variant is the physical
// frame (its color is the frame's color); a lens tint/variety is a
// LensOption and never reuses ProductVariant.color.

/// A lens line ("HD", "Fotocromático", "Espectro"…). Names, prices and
/// which ones exist are admin data — nothing here is hardcoded.
model LensType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug        String  @unique
  description String?

  /// Effective lens price is `option.priceOverride ?? basePrice`, same
  /// rule as Product.basePrice / ProductVariant.priceOverride.
  basePrice Decimal @map("base_price") @db.Decimal(10, 2)

  /// The only persisted graduation fact. A configuration's
  /// graduationMode CUSTOM is valid only for these types; it never adds
  /// a price in V1 and never stores clinical data (ADR-0023).
  supportsCustomGraduation Boolean @default(false) @map("supports_custom_graduation")

  /// Promotional highlight. Any "N variedades" copy is derived from the
  /// count of active options, never stored or hardcoded.
  isFeatured Boolean @default(false) @map("is_featured")
  sortOrder  Int     @default(0) @map("sort_order")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  options    LensOption[]
  treatments LensTypeTreatment[]
  products   ProductLensType[]
  orderItems OrderItem[]

  @@map("lens_types")
}

/// A variety/tint of a lens line. A type with active options requires
/// picking one; a type with none forbids it.
model LensOption {
  id          String  @id @default(uuid()) @db.Uuid
  lensTypeId  String  @map("lens_type_id") @db.Uuid
  name        String
  /// Immutable once published, unique within its lens type.
  slug        String
  description String?
  /// Optional display swatch (#RRGGBB) entered by the admin.
  swatchHex   String? @map("swatch_hex")

  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)

  /// null = not tracked (availability managed by the shop), 0 = out of
  /// stock, > 0 = in stock. CHECK (stock IS NULL OR stock >= 0) is raw
  /// SQL in the migration. Independent from ProductVariant.stock and
  /// never decremented until Orders exist.
  stock Int?

  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  lensType   LensType    @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([lensTypeId, slug])
  @@index([lensTypeId])
  @@map("lens_options")
}

/// A treatment a lens line includes ("Filtro azul", "Antirreflejo"…).
/// Informative in V1: no price, not selectable by the customer.
model LensTreatment {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  /// Immutable once published — see docs/adr/0013-slug-immutability-enforcement.md
  slug        String  @unique
  description String?

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  lensTypes LensTypeTreatment[]

  @@map("lens_treatments")
}

model LensTypeTreatment {
  lensTypeId  String @map("lens_type_id") @db.Uuid
  treatmentId String @map("treatment_id") @db.Uuid

  lensType  LensType      @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)
  treatment LensTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@id([lensTypeId, treatmentId])
  @@index([treatmentId])
  @@map("lens_type_treatments")
}

/// Explicit, admin-decided compatibility between a frame and a lens
/// line — never inferred from category, never per option.
model ProductLensType {
  productId  String   @map("product_id") @db.Uuid
  lensTypeId String   @map("lens_type_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lensType LensType @relation(fields: [lensTypeId], references: [id], onDelete: Cascade)

  @@id([productId, lensTypeId])
  @@index([lensTypeId])
  @@map("product_lens_types")
}

model Branch {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  address String
  phone   String?

  whatsapp      String?
  /// Free-form per-day opening hours; not normalized into its own table —
  /// no query currently needs to filter/sort by hours.
  hours         Json?
  lat           Float?
  lng           Float?
  googleMapsUrl String? @map("google_maps_url")

  /// Part of the physical address; the earliest non-deleted branch's
  /// postal code is the shipping origin (ADR-0024). Nullable: the real
  /// value is loaded once confirmed — shipping quotes report it as
  /// missing configuration meanwhile, never guess it.
  postalCode String? @map("postal_code")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// Pickup orders snapshot the branch name/address too, so this link
  /// going null never loses the pickup point a customer was given.
  pickupOrders Order[]

  @@map("branches")
}

// Shipping V1 — Phase A. See docs/adr/0024-shipping-boundary.md and
// docs/SHIPPING.md. No Order and no stored addresses yet: DeliveryMethod
// and ShippingAddressInput are shared types only.

enum ShippingQuoteSource {
  CHECKOUT
  ADMIN_SIMULATOR
  ESTIMATE_MATRIX
}

/// Synchronous outcome of one quote attempt. No PENDING on purpose — that
/// is reserved for the future Order.shippingCostStatus.
enum ShippingQuoteStatus {
  QUOTED
  FAILED
  NOT_COVERED
  NOT_CONFIGURED
}

/// Admin-managed package used to quote a delivery. At most one active
/// profile is the default — enforced in the service inside a transaction
/// serialized by an advisory lock (a partial unique index would be
/// unmanaged by this schema, like the pg_trgm index — ADR-0014).
/// CHECK (> 0) on every measure is raw SQL in the migration.
model ShippingPackageProfile {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  weightGrams Int     @map("weight_grams")
  lengthCm    Int     @map("length_cm")
  widthCm     Int     @map("width_cm")
  heightCm    Int     @map("height_cm")
  isDefault   Boolean @default(false) @map("is_default")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("shipping_package_profiles")
}

/// One row per quote attempt that reached the provider stage. Snapshot of
/// origin, destination and package so metrics survive later profile
/// edits. Never stores tokens, headers or raw provider responses.
model ShippingQuoteLog {
  id     String              @id @default(uuid()) @db.Uuid
  source ShippingQuoteSource
  status ShippingQuoteStatus

  provider String
  service  String?

  originPostalCode        String @map("origin_postal_code")
  destinationPostalCode   String @map("destination_postal_code")
  /// ISO 3166-2:AR letter; CHECK in the migration.
  destinationProvinceCode String @map("destination_province_code")

  weightGrams Int @map("weight_grams")
  lengthCm    Int @map("length_cm")
  widthCm     Int @map("width_cm")
  heightCm    Int @map("height_cm")

  declaredValue Decimal? @map("declared_value") @db.Decimal(12, 2)
  providerCost  Decimal? @map("provider_cost") @db.Decimal(12, 2)
  currency      String   @default("ARS")

  estimatedDaysMin  Int?      @map("estimated_days_min")
  estimatedDaysMax  Int?      @map("estimated_days_max")
  validUntil        DateTime? @map("valid_until")
  providerReference String?   @map("provider_reference")

  errorCode  String? @map("error_code")
  latencyMs  Int?    @map("latency_ms")
  policyCode String  @map("policy_code")

  createdAt DateTime @default(now()) @map("created_at")

  orders Order[]

  @@index([createdAt])
  @@index([destinationProvinceCode])
  @@map("shipping_quotes")
}

// Payments V1 — Phase A: the transactional order domain (ADR-0025,
// docs/PAYMENTS.md). No Cart/CartItem on purpose: the cart is frontend
// state and an Order is born only when checkout is confirmed, with every
// price and every stock check redone server-side.
//
// Two rules shape almost every column below:
//   1. An order is history. Catalog rows keep changing (and a
//      ProductVariant is a hard delete, ADR-0021), so every fact a
//      customer bought is snapshotted here and every catalog FK is
//      nullable with onDelete: SetNull — the order survives the catalog.
//   2. Shipping keeps three separate amounts (ADR-0024): what the
//      carrier charges, what the customer pays (0 under
//      FREE_NATIONAL_V1) and what the business absorbs. Unknown stays
//      null, never 0.
//
// No clinical data: a CUSTOM graduation is a mode plus a flag, the shop
// coordinates the prescription afterwards (ADR-0023).

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

/// Minimal set Phase A actually needs. Logistics states (SHIPPED,
/// DELIVERED…) are deliberately absent until there is a fulfilment flow
/// to drive them.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  /// Paid, but the reserved stock could not be recovered (a payment
  /// approved after the reservation expired). Needs a human.
  PAID_NEEDS_REVIEW
  CANCELLED
  EXPIRED
}

/// Whether the real carrier cost of this order is known. The customer
/// price is unaffected: it is 0 under FREE_NATIONAL_V1 either way.
enum ShippingCostStatus {
  PENDING
  KNOWN
  UNAVAILABLE
}

/// Snapshot of the graduation mode chosen for one line (ADR-0023).
enum OrderGraduationMode {
  NONE
  CUSTOM
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable and stable, from a Postgres sequence (never MAX+1,
  /// never a row count). Public but not a secret: access is granted by
  /// publicAccessTokenHash, not by guessing this.
  orderNumber String @unique @map("order_number")

  /// SHA-256 of the guest access token, same reasoning as RefreshToken:
  /// the raw value is returned once, at creation, and never stored or
  /// logged. Compared with a timing-safe equality check.
  publicAccessTokenHash String @unique @map("public_access_token_hash")

  /// null = guest checkout. SetNull so deleting an account never deletes
  /// commercial history.
  userId String? @map("user_id") @db.Uuid

  // Contact snapshot — never read back through `userId`, which may be
  // null (guest) or point at an account whose data changed since.
  customerFirstName String  @map("customer_first_name")
  customerLastName  String  @map("customer_last_name")
  customerEmail     String  @map("customer_email")
  customerPhone     String? @map("customer_phone")

  deliveryMethod DeliveryMethod @map("delivery_method")

  // Delivery address snapshot (DELIVERY only; all null for PICKUP).
  // Mirrors ShippingAddressInput — an order stores the address, there is
  // no address book and no reuse across orders (guest checkout).
  deliveryRecipient    String? @map("delivery_recipient")
  deliveryStreetName   String? @map("delivery_street_name")
  deliveryStreetNumber String? @map("delivery_street_number")
  deliveryFloor        String? @map("delivery_floor")
  deliveryApartment    String? @map("delivery_apartment")
  deliveryCity         String? @map("delivery_city")
  /// ISO 3166-2:AR letter; CHECK in the migration, like shipping_quotes.
  deliveryProvinceCode String? @map("delivery_province_code")
  deliveryPostalCode   String? @map("delivery_postal_code")
  deliveryReferences   String? @map("delivery_references")

  // Pickup snapshot (PICKUP only): the branch may be renamed or removed
  // later, so its name and address are frozen here too.
  pickupBranchId   String? @map("pickup_branch_id") @db.Uuid
  pickupBranchName String? @map("pickup_branch_name")
  pickupAddress    String? @map("pickup_address")

  // Billing — deliberately minimal and optional: the client's fiscal
  // rules are not defined yet and ARCA is out of Payments V1. No VAT
  // condition, no invoice type, no CAE.
  invoiceRequested   Boolean @default(false) @map("invoice_requested")
  billingName        String? @map("billing_name")
  billingTaxId       String? @map("billing_tax_id")
  billingAddressLine String? @map("billing_address_line")

  // Money — Decimal only; CHECKs (>= 0) in the migration.
  itemsSubtotal         Decimal  @map("items_subtotal") @db.Decimal(12, 2)
  /// What the customer pays for shipping: 0 under FREE_NATIONAL_V1.
  customerShippingPrice Decimal  @map("customer_shipping_price") @db.Decimal(12, 2)
  /// Internal business data, never part of a public response. null =
  /// unknown (no carrier configured yet) — never shown as 0.
  providerShippingCost  Decimal? @map("provider_shipping_cost") @db.Decimal(12, 2)
  absorbedShippingCost  Decimal? @map("absorbed_shipping_cost") @db.Decimal(12, 2)
  grandTotal            Decimal  @map("grand_total") @db.Decimal(12, 2)
  currency              String   @default("ARS")

  shippingPolicyCode String             @map("shipping_policy_code")
  shippingCostStatus ShippingCostStatus @map("shipping_cost_status")
  /// The quote attempt this order was created from, when there was one.
  shippingQuoteLogId String?            @map("shipping_quote_log_id") @db.Uuid

  status                      OrderStatus @default(PENDING_PAYMENT)
  /// True when any line was configured with a CUSTOM graduation: the
  /// shop must contact the customer. Never a prescription.
  requiresOpticalConsultation Boolean     @default(false) @map("requires_optical_consultation")

  /// Stock is decremented when the order is created; this is until when
  /// it stays reserved while payment is pending (order-policy.ts).
  stockReservedUntil DateTime? @map("stock_reserved_until")
  /// Set once, when the reservation was given back. Together with the
  /// status transition it makes releasing idempotent.
  stockReleasedAt    DateTime? @map("stock_released_at")
  paidAt             DateTime? @map("paid_at")
  cancelledAt        DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  pickupBranch     Branch?           @relation(fields: [pickupBranchId], references: [id], onDelete: SetNull)
  shippingQuoteLog ShippingQuoteLog? @relation(fields: [shippingQuoteLogId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]

  @@index([userId])
  @@index([createdAt])
  /// Drives the expiry sweep: pending orders whose reservation ran out.
  @@index([status, stockReservedUntil])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  // Every catalog FK is nullable + SetNull: ProductVariant is a hard
  // delete (ADR-0021) and the lens catalog is soft-deleted, but a sold
  // line must never lose its history. The snapshots below are what the
  // customer actually bought.
  productId    String? @map("product_id") @db.Uuid
  variantId    String? @map("variant_id") @db.Uuid
  lensTypeId   String? @map("lens_type_id") @db.Uuid
  lensOptionId String? @map("lens_option_id") @db.Uuid

  productName     String  @map("product_name")
  productSlug     String  @map("product_slug")
  variantSku      String  @map("variant_sku")
  variantColor    String? @map("variant_color")
  variantMaterial String? @map("variant_material")

  lensTypeName   String?  @map("lens_type_name")
  lensOptionName String?  @map("lens_option_name")
  /// Names only, frozen: treatments are informative (ADR-0023).
  lensTreatments String[] @default([]) @map("lens_treatments")

  graduationMode              OrderGraduationMode @map("graduation_mode")
  requiresOpticalConsultation Boolean             @default(false) @map("requires_optical_consultation")

  /// True when this line decremented LensOption.stock — i.e. the option
  /// tracks stock (`stock` is not null). Releasing a reservation gives
  /// back exactly what was taken, never a lens whose stock is untracked.
  lensStockReserved Boolean @default(false) @map("lens_stock_reserved")

  // Money frozen at purchase time; CHECKs (>= 0, quantity > 0) in the
  // migration. unitPrice = framePrice + lensPrice, lineTotal =
  // unitPrice * quantity — both computed as Decimal, server-side.
  framePrice Decimal @map("frame_price") @db.Decimal(12, 2)
  lensPrice  Decimal @map("lens_price") @db.Decimal(12, 2)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity   Int
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  lensType   LensType?       @relation(fields: [lensTypeId], references: [id], onDelete: SetNull)
  lensOption LensOption?     @relation(fields: [lensOptionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// 0..N per order: a retry is a new row, never an edit of the previous
/// attempt. No provider is integrated in Phase A — this is the shape the
/// future PaymentProvider adapter writes into.
model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  /// "MERCADOPAGO" when that adapter exists. A plain string, not an
  /// enum: adding a provider must not be a database migration.
  provider             String
  /// The provider's payment (transaction) id, once one exists (D2).
  providerPaymentId    String? @map("provider_payment_id")
  /// Unused by the Mercado Pago integration: it is Checkout Pro via the
  /// Orders API, which has no preference object (ADR-0026). Kept, not
  /// dropped — migrations here are additive.
  providerPreferenceId String? @map("provider_preference_id")
  /// The provider's remote order for this attempt (Mercado Pago Orders
  /// API `id`). Null until the provider confirms the create — a row with
  /// no remote order yet is an attempt whose outcome is unknown and is
  /// retried with the same idempotencyKey (ADR-0026).
  providerOrderId      String? @map("provider_order_id")
  /// Where the buyer is sent to pay (Checkout Pro redirect). Not a
  /// secret; kept so a repeated click reuses it instead of re-creating.
  checkoutUrl          String? @map("checkout_url")
  /// What the provider echoes back to identify the order (the order id).
  externalReference    String  @map("external_reference")
  /// Sent to the provider so a retried create is never a second charge.
  idempotencyKey       String  @unique @map("idempotency_key")

  status               PaymentStatus @default(PENDING)
  /// Raw provider values, kept for support/debugging next to the
  /// normalized `status` this domain actually branches on.
  providerStatus       String?       @map("provider_status")
  providerStatusDetail String?       @map("provider_status_detail")

  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("ARS")
  /// Payment method reported by the provider (card, cash…); never card data.
  method      String?
  approvedAt  DateTime? @map("approved_at")
  failureCode String?   @map("failure_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Postgres treats NULLs as distinct, so many rows may sit with no
  /// provider id yet while a given real payment can only be recorded once.
  @@unique([provider, providerPaymentId])
  @@unique([provider, providerOrderId])
  @@index([orderId])
  @@map("payments")
}

/// Lifecycle of one signed notification (ADR-0027). RECEIVED → PROCESSING
/// (claimed with a lease) → PROCESSED | FAILED_FINAL, or FAILED_RETRYABLE
/// (provider unreachable, remote order not available yet…) which a
/// redelivery or reprocessPaymentEvent() claims again.
enum PaymentEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED_RETRYABLE
  FAILED_FINAL
}

/// Webhook ledger — the row that makes webhook processing idempotent
/// (ADR-0027). Only signature-verified notifications are stored; a
/// duplicate delivery collides on (provider, providerEventId) and never
/// runs side effects twice. Never stores headers, signatures or payloads.
model PaymentEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  provider            String
  /// The notification's own id (body `id`), Mercado Pago's per-notification
  /// identifier — redeliveries of the same notification repeat it.
  providerEventId     String             @map("provider_event_id")
  /// Notification type ("order" for the Orders API).
  topic               String
  /// Body `action`, e.g. "order.processed". Informative only: the state
  /// applied always comes from reading the remote order server-side.
  action              String?
  /// The remote order the notification is about (signed `data.id`).
  providerOrderId     String?            @map("provider_order_id")
  /// The provider's payment (transaction) id, once reconciliation finds an
  /// accredited one. Never an order id.
  providerPaymentId   String?            @map("provider_payment_id")
  /// x-request-id, for correlating with the provider's delivery logs.
  requestId           String?            @map("request_id")
  status              PaymentEventStatus @default(RECEIVED)
  /// Processing attempts (webhook deliveries + manual reprocessing).
  attempts            Int                @default(0)
  /// Lease start while PROCESSING; a stale lease can be reclaimed.
  processingStartedAt DateTime?          @map("processing_started_at")
  /// Normalized provider error kind of the last failed attempt.
  lastErrorKind       String?            @map("last_error_kind")
  receivedAt          DateTime           @default(now()) @map("received_at")
  processedAt         DateTime?          @map("processed_at")
  /// Short machine-readable result ("APPROVED", "AMOUNT_MISMATCH"…).
  outcome             String?
  signatureValid      Boolean            @map("signature_valid")

  @@unique([provider, providerEventId])
  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@index([status])
  @@map("payment_events")
}

/// CUSTOMER | ADMIN today — the minimum useful model for this phase.
/// ADR-0005 approves a richer eventual set (customer | staff | admin |
/// super_admin); adding more values later is an additive enum change,
/// not a rewrite, so it isn't pre-built here (per this phase's own
/// "start minimal" direction).
enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  /// Nullable per ADR-0011: OAuth-only users (not implemented yet) will
  /// never have one. A local-auth user always has one — enforced in
  /// application code (the register flow), not the schema, since the
  /// schema must stay valid for the future OAuth case too.
  passwordHash String? @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  role Role @default(CUSTOMER)

  /// Both nullable per ADR-0011 — present from this migration so a
  /// future OAuth strategy is an additive change, not a users-table
  /// migration. Unused by any code path in this phase.
  authProvider   String? @map("auth_provider")
  authProviderId String? @map("auth_provider_id")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  favorites      Favorite[]
  refreshTokens  RefreshToken[]
  opticalProfile CustomerOpticalProfile?
  /// SetNull on delete: commercial history outlives an account.
  orders         Order[]

  @@map("users")
}

/// Opaque, rotating refresh credential per ADR-0006 — never a JWT itself
/// (nothing to decode; a database lookup is the whole point, so reuse
/// after rotation or logout can actually be detected/revoked). Only a
/// SHA-256 hash of the raw token is stored, same reasoning as password
/// hashing: a database read alone must never be enough to impersonate a
/// session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// A customer can favorite a given product only once — enforced by the
  /// database, not just application logic (§21 of the auth/favorites
  /// brief).
  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

/// Canonical machine values for frame shape — chosen to already match
/// this catalog's own free-text `Product.shape` values where seeded data
/// overlaps (aviator, rectangular, round, wrap all appear verbatim in
/// prisma/seed.ts today) plus the remaining shapes named in the optical-
/// profile brief. `Product.shape`/`ProductVariant.material`/`.color`
/// remain plain free text — see docs/adr/0019 for why a catalog-schema
/// change was deliberately avoided and how the future recommender is
/// expected to reconcile the two sides instead.
enum FrameShape {
  AVIATOR
  RECTANGULAR
  ROUND
  SQUARE
  CAT_EYE
  OVAL
  WRAP
}

/// Mirrors the material strings actually seeded (METAL/ACETATE/TR90 ~
/// "Metal"/"Acetato"/"TR90") plus common additional eyewear materials.
enum FrameMaterial {
  METAL
  ACETATE
  TR90
  MIXED
  INJECTED
  NYLON
}

/// A small set of color *families*, not an attempt to enumerate every
/// real color name — `ProductVariant.color` is free text ("Carey",
/// "Habano", ...) and always will be for physical-product reasons (real
/// frame colors don't fit a short enum). This exists so a customer can
/// express "I like black frames" as a stable, queryable value; matching
/// it against catalog rows is a future normalization step, not exact
/// string equality.
enum ColorFamily {
  NEGRO
  CAREY
  DORADO
  PLATEADO
  AZUL
  ROJO
  VERDE
  TRANSPARENTE
  ROSA
  HABANO
  MULTICOLOR
}

/// Deliberately small and explainable (§14 of the optical-profile
/// brief) — not a fine-grained taxonomy.
/// ADR-0028.
enum ProductKind {
  FRAME
  ACCESSORY
}

/// ADR-0028. What an accessory is — decides where it may be used later
/// (included case/cord slots). OTHER covers anything not listed yet.
enum AccessoryRole {
  CASE
  CORD
  CUSTOM_CORD
  CLEANER
  OTHER
}

enum StylePreference {
  CLASSIC
  MODERN
  MINIMALIST
  ELEGANT
  URBAN
  BOLD
}

/// One-to-zero-or-one with User (`userId @unique`) — a dedicated entity
/// rather than columns piled onto User, so this stays a clean,
/// independently-evolvable "input data for a future recommender" concept
/// (§16) instead of User accumulating every future preference field
/// directly. See docs/adr/0019-optical-profile-taxonomy.md.
///
/// NOT a prescription: no sphere/cylinder/axis/addition/prism/visual-
/// acuity/diagnosis field exists here or is planned for this entity —
/// see ADR-0008 (no facial-data persistence) and the optical-profile
/// brief's own explicit boundary. `current_frame_*` naming (not
/// `preferred_*`) for the measured facts, per ADR-0012 — this model
/// also adds `currentFrameLensHeight`, which ADR-0012 already named
/// alongside the other three even though it predates this phase's own
/// (3-field) brief; included here to stay consistent with that earlier,
/// already-approved naming decision rather than silently dropping it.
model CustomerOpticalProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// All four nullable independently — a customer may know only part of
  /// their frame's own printed markings (§8). Millimeters; see the ADR
  /// for the validation ranges and why they're plausibility bounds, not
  /// medical/manufacturing tolerances.
  currentFrameLensWidth    Float? @map("current_frame_lens_width")
  currentFrameBridgeWidth  Float? @map("current_frame_bridge_width")
  currentFrameTempleLength Float? @map("current_frame_temple_length")
  currentFrameLensHeight   Float? @map("current_frame_lens_height")

  preferredShapes    FrameShape[]      @map("preferred_shapes")
  preferredMaterials FrameMaterial[]   @map("preferred_materials")
  preferredColors    ColorFamily[]     @map("preferred_colors")
  preferredStyles    StylePreference[] @map("preferred_styles")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_optical_profiles")
}

// Electronic invoicing of ONLINE purchases only (ARCA WSAA + WSFEv1, CAE).
// See docs/adr/0036-arca-electronic-invoicing-boundary.md and
// docs/FACTURACION_ARCA.md. In-store sales keep being invoiced from ARCA's
// portal: there is no manual invoicing here. A voucher only exists for an
// online order whose payment was verified with the payment provider.
// Nothing here reserves or deducts stock or changes a product or price.
// Codes are ARCA's own parameter codes, never local inventions.

/// Fiscal identity that issues the online vouchers. Every fiscal choice
/// starts null and blocks issuing until an admin records what the
/// accountant confirmed.
model FiscalIssuer {
  id                String    @id @default(uuid()) @db.Uuid
  cuit              String
  legalName         String    @map("legal_name")
  commercialAddress String    @map("commercial_address")
  grossIncomeNumber String?   @map("gross_income_number")
  activityStartDate DateTime? @map("activity_start_date") @db.Date

  /// ARCA IVA condition code of the issuer, as confirmed.
  taxConditionCode        Int?      @map("tax_condition_code")
  taxConditionConfirmedAt DateTime? @map("tax_condition_confirmed_at")
  taxConditionConfirmedBy String?   @map("tax_condition_confirmed_by") @db.Uuid

  /// Total from which a final consumer must be identified (current
  /// regulation). null = unknown: an unidentified buyer waits for data.
  finalConsumerIdThreshold Decimal? @map("final_consumer_id_threshold") @db.Decimal(13, 2)

  /// VAT rate (FEParamGetTiposIva code) of each part of an online sale,
  /// as the accountant defines it. null = not confirmed: issuing waits.
  frameVatRateCode     Int? @map("frame_vat_rate_code")
  lensVatRateCode      Int? @map("lens_vat_rate_code")
  accessoryVatRateCode Int? @map("accessory_vat_rate_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pointsOfSale FiscalPointOfSale[]
  sales        Sale[]

  @@map("fiscal_issuers")
}

/// The point of sale enabled for web services (a separate one from the
/// portal's). `enabledVoucherTypes`: ARCA voucher type codes confirmed for
/// it. At most one is used for online sales (`forOnlineSales`).
model FiscalPointOfSale {
  id                  String  @id @default(uuid()) @db.Uuid
  issuerId            String  @map("issuer_id") @db.Uuid
  number              Int
  enabledVoucherTypes Int[]   @map("enabled_voucher_types")
  active              Boolean @default(true)
  forOnlineSales      Boolean @default(false) @map("for_online_sales")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issuer    FiscalIssuer     @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  sequences FiscalSequence[]
  documents FiscalDocument[]

  @@unique([issuerId, number])
  @@map("fiscal_points_of_sale")
}

/// One per (point of sale, voucher type). `inFlightDocumentId` is the
/// emission lock: claimed with a conditional UPDATE before talking to
/// ARCA and released when the voucher is settled (ADR-0036).
model FiscalSequence {
  id                 String  @id @default(uuid()) @db.Uuid
  pointOfSaleId      String  @map("point_of_sale_id") @db.Uuid
  voucherType        Int     @map("voucher_type")
  inFlightDocumentId String? @unique @map("in_flight_document_id") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at")

  pointOfSale FiscalPointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)

  @@unique([pointOfSaleId, voucherType])
  @@map("fiscal_sequences")
}

enum OnlineInvoiceRequestStatus {
  /// Received from the payment confirmation, not processed yet.
  RECEIVED
  /// Something needed for the voucher is missing (buyer's IVA condition,
  /// document, VAT rates…): `blockerReason` says what.
  WAITING_DATA
  /// The sale and its voucher exist (the voucher has its own status).
  INVOICED
}

/// A paid online order handed to invoicing — one per order, ever. Keeps
/// the order exactly as it was paid (`orderSnapshot`), so the voucher can
/// always be traced back to the original sale.
model OnlineInvoiceRequest {
  id                String                     @id @default(uuid()) @db.Uuid
  /// The online order's id (no FK: orders live in the checkout module).
  orderId           String                     @unique @map("order_id") @db.Uuid
  orderNumber       String                     @map("order_number")
  paymentProvider   String                     @map("payment_provider")
  paymentReference  String                     @map("payment_reference")
  paymentApprovedAt DateTime                   @map("payment_approved_at")
  buyerEmail        String                     @map("buyer_email")
  orderSnapshot     Json                       @map("order_snapshot")
  status            OnlineInvoiceRequestStatus @default(RECEIVED)
  blockerReason     String?                    @map("blocker_reason")

  /// Completed by an admin when the order did not carry them (the
  /// checkout does not ask for the buyer's IVA condition today).
  receptorIvaConditionCode Int? @map("receptor_iva_condition_code")
  receptorDocType          Int? @map("receptor_doc_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sale Sale?

  @@index([status])
  @@map("online_invoice_requests")
}

/// What was sold, as the voucher states it — derived from the request.
model Sale {
  id        String   @id @default(uuid()) @db.Uuid
  issuerId  String   @map("issuer_id") @db.Uuid
  requestId String   @unique @map("request_id") @db.Uuid
  saleDate  DateTime @map("sale_date") @db.Date

  receptorDocType          Int     @map("receptor_doc_type")
  receptorDocNumber        String  @map("receptor_doc_number")
  receptorName             String? @map("receptor_name")
  receptorIvaConditionCode Int     @map("receptor_iva_condition_code")
  receptorAddress          String? @map("receptor_address")

  currency       String  @default("PES")
  untaxedAmount  Decimal @map("untaxed_amount") @db.Decimal(13, 2)
  exemptAmount   Decimal @map("exempt_amount") @db.Decimal(13, 2)
  netAmount      Decimal @map("net_amount") @db.Decimal(13, 2)
  vatAmount      Decimal @map("vat_amount") @db.Decimal(13, 2)
  otherTaxAmount Decimal @map("other_tax_amount") @db.Decimal(13, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(13, 2)

  createdAt DateTime @default(now()) @map("created_at")

  issuer   FiscalIssuer         @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  request  OnlineInvoiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  document FiscalDocument?

  @@map("sales")
}

/// A line of the voucher. `grossAmount` is what the buyer paid for it
/// (VAT included); `netAmount`/`vatAmount` its breakdown.
model SaleItem {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @map("sale_id") @db.Uuid
  position    Int
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(13, 2)
  /// ARCA VAT rate code (FEParamGetTiposIva); null for class C.
  vatRateCode Int?    @map("vat_rate_code")
  grossAmount Decimal @map("gross_amount") @db.Decimal(13, 2)
  netAmount   Decimal @map("net_amount") @db.Decimal(13, 2)
  vatAmount   Decimal @map("vat_amount") @db.Decimal(13, 2)
  variantSku  String? @map("variant_sku")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([saleId, position])
  @@map("sale_items")
}

/// DRAFT → SENDING → AUTHORIZED | REJECTED | UNCERTAIN; UNCERTAIN is only
/// settled by asking ARCA (FECompConsultar) → AUTHORIZED | DRAFT |
/// NEEDS_REVIEW. Vouchers are never deleted.
enum FiscalDocumentStatus {
  DRAFT
  SENDING
  AUTHORIZED
  REJECTED
  UNCERTAIN
  NEEDS_REVIEW
}

model FiscalDocument {
  id            String               @id @default(uuid()) @db.Uuid
  saleId        String               @unique @map("sale_id") @db.Uuid
  pointOfSaleId String               @map("point_of_sale_id") @db.Uuid
  voucherType   Int                  @map("voucher_type")
  /// Assigned from FECompUltimoAutorizado + 1 right before sending.
  number        Int?
  status        FiscalDocumentStatus @default(DRAFT)
  /// "mock" | "homologacion" — production is not wired (ADR-0036).
  environment   String
  conceptCode   Int                  @map("concept_code")

  cae            String?
  caeDueDate     DateTime? @map("cae_due_date") @db.Date
  authorizedAt   DateTime? @map("authorized_at")
  attempts       Int       @default(0)
  /// "order:<orderId>": one voucher per paid order, ever.
  idempotencyKey String    @unique @map("idempotency_key")

  /// The FECAEDetRequest sent (no Auth), ARCA's observations and errors.
  requestSnapshot  Json? @map("request_snapshot")
  arcaObservations Json? @map("arca_observations")
  arcaErrors       Json? @map("arca_errors")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sale        Sale                  @relation(fields: [saleId], references: [id], onDelete: Restrict)
  pointOfSale FiscalPointOfSale     @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  events      FiscalAuditEvent[]
  email       InvoiceEmailDelivery?

  @@unique([pointOfSaleId, voucherType, number])
  @@index([status])
  @@map("fiscal_documents")
}

/// Sending the PDF to the buyer — a state of its own, separate from the
/// voucher: resending never issues another voucher.
enum InvoiceEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model InvoiceEmailDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  documentId        String             @unique @map("document_id") @db.Uuid
  recipient         String
  status            InvoiceEmailStatus @default(PENDING)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime?          @map("next_attempt_at")
  lastError         String?            @map("last_error")
  providerMessageId String?            @map("provider_message_id")
  sentAt            DateTime?          @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@map("invoice_email_deliveries")
}

/// Every transition of a request, voucher or email. Never stores tokens,
/// signatures, certificates or keys.
model FiscalAuditEvent {
  id         String                @id @default(uuid()) @db.Uuid
  documentId String?               @map("document_id") @db.Uuid
  requestId  String?               @map("request_id") @db.Uuid
  action     String
  fromStatus FiscalDocumentStatus? @map("from_status")
  toStatus   FiscalDocumentStatus? @map("to_status")
  actorId    String?               @map("actor_id") @db.Uuid
  details    Json?
  createdAt  DateTime              @default(now()) @map("created_at")

  document FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([requestId, createdAt])
  @@map("fiscal_audit_events")
}

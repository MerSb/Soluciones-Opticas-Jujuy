{
  "name": "@soluciones-opticas/api",
  "private": true,
  "version": "0.0.0",
  "description": "Public read-only catalog API (Etapa 1).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@soluciones-opticas/shared": "*",
    "cors": "^2.8.5",

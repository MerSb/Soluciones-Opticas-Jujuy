# Copy to .env.local for local development (Vite loads .env.local from
# this directory automatically — no --env-file flag needed, unlike
# apps/api). Never commit the real .env.local file.
#
# Only VITE_-prefixed variables are exposed to client code, by Vite's own
# design — never put a secret here, this ships to the browser.

# Local: apps/api dev server. Staging (once provisioned): the Railway API
# URL — see docs/ENVIRONMENT.md.
VITE_API_BASE_URL=http://localhost:3001

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src", "test"],
  // Runs on Vercel (Node), not in the browser: type-checked by tsconfig.node.json.
  "exclude": ["test/middleware.test.ts", "test/preview-api.test.ts"]
}
